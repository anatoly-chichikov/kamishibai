                            Source(file: "src/cli/shell.rs", symbol: "finish_generation_stop"),
                        ],
                    ),
                ],
            ),
        ),
        Rule(head: Head(id: "cards.metadata-preview", intent: "An open card names each part of the study material in plain terms, with statements for what was made and questions only for what can be changed"),
            scope: States(["cards.open", "cards.tuning", "cards.parked", "cards.scroll-end", "cards.rewriting", "cards.legacy-tuning"]),
