                    Check(file: "src/cli/terminal.rs", test: "saved_key_does_not_skip_unconfirmed_language_choice"),
                    Check(file: "src/cli/terminal.rs", test: "confirmed_language_without_key_starts_on_key_stage"),
                    Check(file: "src/tui/screens/welcome.rs", test: "key_recovery_cannot_ask_for_an_already_chosen_language"),
                    Check(file: "src/cli/terminal.rs", test: "confirmed_language_and_saved_key_skip_welcome"),
