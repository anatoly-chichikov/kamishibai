        Rule(head: Head(id: "shell.ownership", intent: "Developers can test each transit step as a pure state change without a terminal, provider or clock, because timing, input reading and side effects stay in the shell"),
            scope: Everywhere,
            expectations: [
                "transit(App, AppEvent) returns the next App and a Side; it performs no IO and the shell executes every Side",
                "The terminal loop redraws on resize and consumes Ctrl+C and the Ctrl+N/Ctrl+P scroll pair before transit; the shell pumps the session engine and owns every timed destructive confirmation (Esc clear, stop and new cards, Ctrl+C quit), stop draining and publication",
                "Engine progress returns to the interface as AppEvents instead of mutating App directly",
                "The terminal loop hit-tests clicks: output links open directly with the system handler, while choice, picker, chip and disclosure clicks become AppEvents that go through transit",
            ],
            grounds: Grounds(
                rationale: [
                    "A pure transit lets transition tests assert whole state changes without a terminal, provider or clock; confirmations that need wall-clock windows therefore live in the shell, which is why single transit calls cannot prove them",
                ],
                sources: [
                    Source(file: "src/tui/transition.rs", symbol: "transit"),
                    Source(file: "src/cli/shell.rs", symbol: "handle_destructive_escape"),
                    Source(file: "src/cli/terminal.rs", symbol: "scroll_hotkey_screen"),
                ],
                tests: [
                    Check(file: "tests/state_machine.rs", test: "skeleton_flow_publishes_done_inline_on_your_cards"),
                    Check(file: "tests/state_machine.rs", test: "escape_on_words_requests_a_guarded_clear_without_touching_the_text"),
                    Check(file: "src/cli/shell.rs", test: "words_clear_confirmation_expires_after_the_confirmation_window"),
                    Check(file: "src/cli/shell.rs", test: "second_escape_starts_draining_without_dropping_the_engine"),
                    Check(file: "src/cli/shell.rs", test: "stop_applies_the_inflight_outcome_then_publishes_only_ready_cards"),
                    Check(file: "src/cli/shell.rs", test: "a_step_holds_its_row_for_its_own_beat_before_it_settles"),
                ],
            ),
        ),
        Rule(head: Head(id: "removed.features", intent: "Features cut for confusing the learner stay out, and each reason is kept so a later change does not quietly bring back a half-working key or screen"),
            scope: Everywhere,
            expectations: [
                "There is no [L] flip key and no [T] target-cycle key",
                "There is no per-card modal; sentence tuning lives inline below the card's step rows",
                "Tab and Shift+Tab map to no event; there is no jump to the next unfinished card",
                "There is no Retry or Failure fullscreen; failures stay in the batch",
                "No hint names Cmd+V",
                "Commas are literal content, never separators; input is one item per line",
                "There is no Ctrl+S recording chord; Ctrl+G generates everywhere",
                "No alternative UI stack replaces ratatui and crossterm",
            ],
            grounds: Grounds(
                rationale: [
                    "[T] cycled targets without a clear destination and [L] duplicated the pair picker; both were half-working features cut in favour of the explicit language pair",
                    "A per-card modal hid the batch while tuning one card; the inline editor keeps every other card and the step rows in view",
                    "Tab navigation was removed because during a build the viewport already rides the running card and afterwards a broken card announces itself with its one bright ✗ while Ctrl+G re-rolls every failure at once",
                    "Failures are part of the batch outcome, so a separate failure screen would hide the cards that did succeed",
                    "The app never dispatches on Cmd+V: a terminal replays a paste as ordinary characters, and the spelling is macOS-only",
                    "Phrases legitimately contain commas, so only newlines separate items",
                    "Ctrl+G is a plain control byte crossterm reads in raw mode, so no recording-only key patch is needed",
                ],
                sources: [
                    Source(file: "src/tui/input.rs", symbol: "to_app"),
                    Source(file: "src/tui/screens/your_words.rs", symbol: "hints"),
                    Source(file: "src/tui/screen.rs", symbol: "ModalKind"),
                ],
                tests: [
                    Check(file: "tests/keyboard.rs", test: "tab_carries_no_meaning_of_its_own"),
                    Check(file: "tests/language_context.rs", test: "letter_l_on_done_is_not_a_hidden_language_shortcut"),
                    Check(file: "tests/sentence_labels_editor.rs", test: "both_r_keys_are_inert_while_space_opens_the_card_and_a_tag_opens_the_live_editor"),
                    Check(file: "tests/failure_recovery.rs", test: "recovery_keeps_the_user_on_your_cards"),
                    Check(file: "tests/your_words.rs", test: "an_empty_words_box_spends_no_brightness_on_a_key_the_app_does_not_own"),
                    Check(file: "src/cli/shell.rs", test: "first_pass_keeps_commas_inside_lines"),
                ],
            ),
        ),
    ],
    map: Map(
        screens: [
            Screen(head: Head(id: "welcome", intent: "Setup asks only what cannot be guessed: the learner's own language once and a Gemini key that has been checked; a later key failure asks for the key alone"),
                screen: "Welcome",
            ),
            Screen(head: Head(id: "words", intent: "Words and phrases arrive in either language exactly as typed; nothing is sent until asked for, and nothing typed is lost to a single key"),
