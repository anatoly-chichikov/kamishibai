                ],
            ),
        ),
        Rule(head: Head(id: "escape.lifecycle", intent: "Words, a running build or a settled result are never lost to one stray key; each loss takes a second press within a second, and Escape peels the nearest layer first"),
            scope: Everywhere,
            expectations: [
                "Clear words, stop generation, start new cards and quit each use independent one-second confirmation windows",
                "The first destructive key names the consequence and then changes to a bright bold again; any other key, mapped or not, a click, a drag, the wheel or the timeout disarms an Escape confirmation, while an armed quit survives mouse input and unmapped keys",
                "Escape peels the focused layer before a screen action: error, modal, live editor, expanded card or sense list",
                "Open blocks on other rows do not intercept Escape; C closes them all",
                "Returning from review preserves words and leaves clear unarmed; it takes two fresh Escape presses to clear",
                "Confirmed stop drains the active request, accepts its outcome and starts no next provider work",
                "If complete cards remain, stop publishes only that subset as partial; with no complete card it cancels the old session, rotates identity/cost scope and opens clean words",
                "Settled live and reopened final views offer muted [Esc] new cards immediately before quit whenever the focused card is collapsed and no editor is live; double Escape preserves preferences and output while rotating session and cost scope",
                "Total failure permits the same reset after dismissing any publication error",
                "Confirmed stop keeps its session ownership and stop intent through draining and subset publication; a failed stopped publication durably cancels and rotates into clean input with a saving diagnostic instead of restarting provider work",
            ],
            grounds: Grounds(
                rationale: [
                    "Every destructive Escape takes two beats and names its loss on the first, so no key in the app is met by surprise",
                ],
                sources: [
                    Source(file: "src/cli/shell.rs", symbol: "handle_destructive_escape"),
                    Source(file: "src/cli/shell.rs", symbol: "handle_new_batch_escape"),
                    Source(file: "src/cli/shell.rs", symbol: "finish_generation_stop"),
                    Source(file: "src/cli/shell.rs", symbol: "arm_quit"),
                ],
                tests: [
                    Check(file: "src/cli/shell.rs", test: "words_clear_confirmation_expires_after_the_confirmation_window"),
                    Check(file: "src/cli/shell.rs", test: "escape_closes_an_open_sentence_editor_before_arming_a_new_batch"),
                    Check(file: "src/cli/shell.rs", test: "review_back_resets_the_words_double_escape_confirmation"),
                    Check(file: "src/cli/shell.rs", test: "stop_applies_the_inflight_outcome_then_publishes_only_ready_cards"),
                    Check(file: "src/cli/shell.rs", test: "second_escape_on_reopened_done_starts_clean_words_in_place"),
                    Check(file: "src/cli/shell.rs", test: "failed_publish_after_stop_starts_clean_without_resuming"),
                ],
            ),
        ),
        Rule(head: Head(id: "overlay.ownership", intent: "Waiting on a request or recovering from one never costs work: a running request ignores stray keys, and one retry press dismisses the error and reruns what failed"),
            scope: States([
                "welcome.checking-key",
                "welcome.key-invalid",
                "welcome.key-recovery",
                "words.understanding",
                "words.error",
                "words.stopped-publish-error",
                "review.understanding",
                "review.correcting",
                "review.correction-error",
                "cards.publish-deck",
                "cards.publish-report",
                "cards.publish-error",
            ]),
            expectations: [
                "Understanding, bulk correction, key validation, deck publication and report publication share one blocking busy overlay",
                "Busy swallows all dispatched non-redraw input; global Ctrl+C is handled by the terminal shell before transit",
                "An error panel titled could not complete request or could not save your cards offers [Ctrl+G] retry and [Esc] dismiss; Ctrl+G dismisses and then runs the screen's own Ctrl+G action, and Escape only dismisses",
                "Other mapped non-redraw app events dismiss errors, but global quit/scroll/unmapped keys are not promised as dismissal",
                "Invalid key checking shows an inline Welcome notice; a rejected saved key returns to Welcome's key stage, and a successful replacement resumes a committed plan or otherwise returns to the retained words without resuming the interrupted understanding or correction",
                "Publication errors stay saving failures; Ctrl+G republishes directly when every card is ready, but first regenerates failed cards, which is paid provider work, when any card failed",
                "Intended error recovery retries the failed operation with Ctrl+G",
            ],
            grounds: Grounds(
                rationale: [],
                sources: [
                    Source(file: "src/tui/transition.rs", symbol: "transit"),
                    Source(file: "src/tui/screens/error.rs", symbol: "draw"),
                    Source(file: "src/cli/shell.rs", symbol: "recover_key_rejection"),
                    Source(file: "src/cli/shell.rs", symbol: "publish_failed"),
                ],
                tests: [
                    Check(file: "tests/change_something.rs", test: "bulk_correction_loader_hides_the_add_more_modal_body"),
                    Check(file: "tests/your_words.rs", test: "busy_loader_owns_keyboard_input_until_request_finishes"),
                    Check(file: "tests/your_words.rs", test: "generate_over_a_shown_error_dismisses_it_and_retries_in_one_press"),
                    Check(file: "tests/your_words.rs", test: "any_other_key_over_a_shown_error_only_dismisses_it"),
                    Check(file: "src/cli/shell.rs", test: "key_rejection_returns_to_welcome_key_step"),
                    Check(file: "src/cli/shell.rs", test: "retrying_a_failed_publication_cannot_regenerate_completed_cards"),
                ],
                gaps: [
                    Gap(
                        summary: "ChangeSomething has no Generate transition, so after a correction error Ctrl+G only dismisses the error and resending needs Enter",
                        sources: [
                            Source(file: "src/tui/transition.rs", symbol: "transit"),
                        ],
                    ),
                    Gap(
                        summary: "Ctrl+G over a review-screen error that did not come from generation, such as a preferences read error after understanding or an unsaved session, starts paid card generation instead of retrying the failed operation",
                        sources: [
                            Source(file: "src/tui/transition.rs", symbol: "transit"),
                            Source(file: "src/cli/shell.rs", symbol: "finish_text"),
                        ],
                    ),
                    Gap(
                        summary: "After a stopped publication fails, the clean words screen shows the error with [Ctrl+G] retry although Ctrl+G only dismisses it",
                        sources: [
