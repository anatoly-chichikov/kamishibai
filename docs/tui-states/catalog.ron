            ]),
            expectations: [
                "Without a confirmed known language a launch opens Welcome's language stage with en preselected and any saved key restored into the key step",
                "A confirmed language without a saved key opens Welcome's key stage with add a working gemini key to continue; GEMINI_API_KEY alone never skips it and only adds the load from env action",
                "A confirmed language with a saved key opens YourWords directly",
                "kamishibai open and a bare cards JSON path open the TUI on a stored session or a prebuilt batch instead",
            ],
            grounds: Grounds(
                rationale: [
                    "The learner states their own language explicitly once, because every gloss and translation is written in it and a silent default would be wrong for most learners",
                ],
                sources: [
                    Source(file: "src/cli/terminal.rs", symbol: "startup_app"),
                    Source(file: "src/cli/terminal.rs", symbol: "env_has_gemini_key"),
