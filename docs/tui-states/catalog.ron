                    Check(file: "src/tui/app.rs", test: "every_chip_and_note_edit_updates_the_selected_pending_draft"),
                    Check(file: "src/cli/shell.rs", test: "ctrl_g_runs_a_staged_sentence_rewrite_inside_the_artifact_engine"),
                ],
