Catalog(
    version: 2,
    verifications: [
        Verification(
            command: "cargo test --test all ui_catalog::",
            establishes: "The catalog decodes into its typed schema; every entry's head sits on one line and its ID is unique across kinds; each intent has at least 8 words and at most 180 characters and is neither a placeholder, a duplicate nor a retelling of the screen; every screen entry names a runtime screen, state IDs carry their screen's prefix and scopes name real screens and states; actions, routes, sources, tests and gaps point at real states, symbols and test functions; every capture decodes, is cataloged and is written by the tape its origin names; every prepared scene is a catalog state whose header and footer equal what the real renderer draws",
            limits: "It never executes a described transition, judges whether an intent is true to the product, or compares a PNG with today's renderer; the chrome of states without a prepared scene stays unverified",
        ),
        Verification(
            command: "cargo test --test all ui_recording::",
            establishes: "The recording procedure lists exactly the tapes on disk, each tape drives what it claims, the demo words are typed by the live tape, step commands name existing tapes and helpers, and every slice uses a declared section kind",
            limits: "It never runs VHS or Gemini; a wait pattern in capture.tape that no longer matches the interface only fails during a live recording",
        ),
        Verification(
            command: "cargo test --test all state_machine::",
            establishes: "The asserted transitions of the pure transit function and their domain effects match separately written expectations",
            limits: "Shell-owned behavior such as timed confirmations, stop draining, publication and quit is outside a single transit call",
        ),
        Verification(
            command: "cargo test --test all keyboard::",
            establishes: "Production key and mouse input maps into the tested app events and rendered results, including the Latin fold of non-Latin keyboard layouts",
            limits: "It covers the asserted keys only; unmapped keys are proven inert only where a test says so",
        ),
        Verification(
            command: "cargo test --test snapshot",
            establishes: "Deterministic TestBackend renders match the reviewed insta snapshots in tests/snapshots at explicit sizes, including narrow and short terminals",
            limits: "Snapshot changes are reviewed with cargo insta review and never blessed automatically in CI; a snapshot proves rendering, not that a user can reach the state",
        ),
        Verification(
            command: "cargo test --test all pty::",
            establishes: "On Unix the real binary boots into Welcome without a key, the plain-text tui_skeleton flow advances through its screens, and the gallery switches the mouse pointer between link and plain cells; expectrl drives the pseudoterminal, and termwright was rejected and is revisited only if expectrl regresses",
            limits: "tui_skeleton prints plain screen markers instead of ratatui's optimised cursor sequences, so it proves flow, not rendering; PTY tests do not run on Windows",
        ),
        Verification(
            command: "cargo test --all-targets --all-features --locked",
            establishes: "The Linux CI suite, examples included, passes with local fakes and temporary resources only: no test reaches the network or the real user configuration, and Gemini requests go to a 127.0.0.1 listener through KAMISHIBAI_GEMINI_URL",
            limits: "Windows CI runs cargo check plus only the config, config_cli and paths modules; a green run says nothing about the correctness of the catalog's intent or the freshness of captures",
        ),
    ],
    rules: [
        Rule(head: Head(id: "inventory.boundary", intent: "Agents editing the TUI can rely on this catalog's links and copy: every reference, test and capture origin must resolve, and prepared scenes must draw its header and footer"),
            scope: Everywhere,
            expectations: [
                "The catalog is the authored inventory of intended states, transitions and scenarios; it is not proof that every transition executes",
                "Screen and overlay describe runtime locations; inline editors, retry and failure variants remain states of those locations",
                "Every capture records its origin; a Synthetic capture must be written by a tape that launches the owning state's scene and a Live capture by capture.tape, and a capture with revision None is a historical reference of unknown freshness",
                "Screenshot fixtures show rendered appearance; transition, shell and PTY tests provide different kinds of behavior evidence",
                "caption.png and capture.gif are demo assets, not independent interface states",
                "Update affected intent, states, routes, sources and evidence in the same change as each TUI feature",
                "chrome records the header title, header hint and footer that the prepared scene renders when the state has one, and the representative situation otherwise; the S-series card scenes are idle unfinished batches with no running card, which is why they offer both [Ctrl+G] regenerate and [Esc] stop",
                "tests lists only checks whose assertions exercise the entry; an empty list means no automated behavior check exists yet",
                "gaps records code behavior that contradicts an expectation today and points at the code; the expectation keeps the intended behavior",
                "rationale records why a rule exists, so a later change can tell a deliberate constraint from an accident",
                "Every entry opens with one head line, Kind(head: Head(id: ..., intent: ...)), so a grep lists kind, ID and intent together",
                "An intent says first what the entry gives the learner, or the developer for a rule about code, and then at most two things it protects; every other guarantee belongs in expectations",
                "An intent names a key only when that key is itself what is protected, and it is derived from code, tests, rules and history; an intent the sources cannot settle stays partial and its question goes to the owner",
                "An intent changes only when a request changes what the learner gets; code that contradicts an expectation becomes a gap instead",
                "A rule's scope names where it applies: Everywhere, whole screens by their ID, or individual states",
                "A screen's ID is the prefix of every state on it: welcome, words, review, cards and done",
            ],
            grounds: Grounds(
                rationale: [
                    "Hand-written Markdown maps drifted from the code unnoticed, and the earlier typed contract checked only its own shape, file paths and a few literal words; this catalog also compares its copy with the real renderer and resolves its links, sources, tests and capture origins against the repository, so that drift fails loudly; it never compares a capture's pixels with today's renderer",
                ],
                sources: [
                    Source(file: "src/tui/screen.rs", symbol: "Screen"),
                    Source(file: "src/tui/transition.rs", symbol: "transit"),
                ],
                tests: [
                    Check(file: "tests/ui_catalog.rs", test: "tui_catalog_cannot_publish_broken_states_routes_or_evidence"),
                    Check(file: "tests/ui_catalog.rs", test: "every_real_capture_fixture_requires_an_intent_state"),
                    Check(file: "tests/ui_catalog.rs", test: "catalog_copy_cannot_drift_from_the_rendered_scenes"),
                    Check(file: "tests/common/tui_catalog.rs", test: "catalog_cannot_omit_runtime_overlays"),
                    Check(file: "tests/common/tui_catalog.rs", test: "synthetic_capture_cannot_come_from_another_scene"),
                    Check(file: "tests/common/tui_catalog.rs", test: "catalog_cannot_cite_a_test_that_does_not_exist"),
                ],
            ),
        ),
        Rule(head: Head(id: "chrome.stack", intent: "Every screen keeps one familiar frame of header, body, reminder and key bar, and no screen or overlay may hide the reminder that AI output needs checking"),
            scope: Everywhere,
            expectations: [
                "The UI stack is frozen: ratatui renders and crossterm owns the terminal backend, input and terminal control; no alternative UI stack is allowed",
                "The full terminal is divided into header, scrollable body, persistent AI reminder, dashed divider and status/footer",
                "The lowercase ai may be wrong, please verify results reminder remains right aligned above the divider; body and overlays cannot erase it",
                "Centered overlays render after the underlying screen with a solid border and padded content",
            ],
            grounds: Grounds(
                rationale: [],
                sources: [
                    Source(file: "src/tui/screens/common.rs", symbol: "render_screen"),
                    Source(file: "src/tui/screens/modals.rs", symbol: "draw"),
                ],
                tests: [
                    Check(file: "tests/snapshot.rs", test: "ai_disclaimer_stays_right_aligned_above_the_divider_on_every_screen"),
                    Check(file: "tests/snapshot.rs", test: "ai_disclaimer_remains_visible_while_overlays_are_open"),
                    Check(file: "tests/snapshot.rs", test: "ai_disclaimer_leaves_the_divider_uninterrupted_below_it"),
                    Check(file: "tests/snapshot.rs", test: "ai_disclaimer_uses_the_full_terminal_width_when_the_copy_fits"),
                    Check(file: "tests/your_words.rs", test: "understanding_busy_overlay_keeps_the_your_words_background"),
                ],
            ),
        ),
        Rule(head: Head(id: "chrome.header", intent: "The header names what is on screen and the one next step worth taking; counts stay in the body, so the card title holds still for a whole run"),
            scope: Everywhere,
            expectations: [
                "The inverted title reads setup, your words, word meanings or your cards; the card title stays your cards through generation, rewriting, publication and the reopened Done view",
                "Welcome hints choose your language and add a gemini key; a launch or recovery that only needs a key hints add a working gemini key to continue",
                "YourWords hints add words or phrases, one per line, and add words in either language, one per line once a learning language is pinned",
                "WhatIUnderstood hints choose the meanings you want to learn",
                "YourCards and Done take the first matching hint: your files will appear here when they're ready while publishing; you can browse while the current step finishes while a stop drains; open a card to see how it's coming along while building; open a card to follow the changes while rewriting; browse the ready cards while the rest are being made while retrying with ready cards",
                "Without activity the card hint continues: apply your changes when you're ready with staged rewrites; start with the ready cards, then retry the rest after a published partial; your files are ready after a complete publication; try again from where things went wrong when every card failed; save them so you can start learning when every card is ready but unpublished; otherwise continue with these cards when you're ready",
                "Active operations outrank idle guidance; pending changes outrank an earlier published outcome",
            ],
            grounds: Grounds(
                rationale: [],
                sources: [
                    Source(file: "src/tui/screens/your_cards.rs", symbol: "header_hint"),
                    Source(file: "src/tui/screens/welcome.rs", symbol: "HINT_KEY"),
                    Source(file: "src/tui/screens/your_words.rs", symbol: "HINT"),
                    Source(file: "src/tui/screens/what_i_understood.rs", symbol: "HINT"),
                ],
                tests: [
                    Check(file: "tests/done.rs", test: "done_screen_lists_short_artifact_labels_and_quit_hint"),
                    Check(file: "src/tui/screens/welcome.rs", test: "initial_setup_keeps_both_steps_in_context_on_the_key_field"),
                    Check(file: "tests/your_words.rs", test: "pinned_learning_language_explains_that_words_can_be_entered_in_either_language"),
                    Check(file: "tests/snapshot.rs", test: "header_hint_sits_left_of_language_chip_on_every_screen"),
                    Check(file: "src/tui/screens/your_cards.rs", test: "stopping_takes_precedence_over_running_and_staged_work"),
                    Check(file: "src/tui/screens/your_cards.rs", test: "staged_changes_cannot_claim_that_the_published_files_are_current"),
                ],
            ),
        ),
        Rule(head: Head(id: "chrome.language-pair", intent: "Which direction a batch is built in stays visible on every screen after setup, and the pair can change only until cards are committed"),
            scope: Everywhere,
            expectations: [
                "Every screen after Welcome shows a bold bright canonical CODE → CODE chip, with ? for an unresolved learning language; Welcome shows no chip",
                "YourWords and WhatIUnderstood edit the pair through Ctrl+L or either header half; on review either half opens the learning column",
                "YourCards and Done display the frozen committed pair without a pair editing action",
                "Welcome asks for the known language before key entry even when GEMINI_API_KEY is available",
                "Language rows preserve native names; right-to-left scripts use their English names because the terminal does not reorder bidi text",
                "In the pair picker auto hands the choice back to detection and stays pinned at the top of the learning column, each column's scroll window follows its pick so the pick is always visible, and the same language shares one row across both columns",
            ],
            grounds: Grounds(
                rationale: [],
                sources: [
                    Source(file: "src/tui/screens/common.rs", symbol: "render_screen"),
                    Source(file: "src/tui/screens/modals.rs", symbol: "draw_picker"),
                    Source(file: "src/tui/picker.rs", symbol: "PickerSection"),
                ],
                tests: [
                    Check(file: "tests/language_context.rs", test: "language_badge_is_consistent_across_every_fullscreen_screen"),
                    Check(file: "tests/language_context.rs", test: "clicking_either_chip_half_on_what_i_understood_focuses_what_youre_learning"),
                    Check(file: "tests/language_context.rs", test: "picker_does_not_open_on_your_cards_or_done_because_the_pair_is_frozen"),
                    Check(file: "src/cli/terminal.rs", test: "env_key_is_not_loaded_at_startup"),
                    Check(file: "src/tui/picker.rs", test: "a_language_row_names_itself_in_its_own_language"),
                    Check(file: "src/tui/screens/modals.rs", test: "the_same_language_shares_a_row_across_both_columns"),
                ],
                gaps: [
                    Gap(
                        summary: "Hindi is listed by its English name although it is written left to right; the rule names only right-to-left scripts as exceptions",
                        sources: [
                            Source(file: "src/languages/registry.rs", symbol: "endonym"),
                        ],
                    ),
                ],
            ),
        ),
        Rule(head: Head(id: "visual.rank-focus", intent: "Any row reads at a glance because ink, row band, weight and underline each keep one meaning on every screen"),
            scope: Everywhere,
            expectations: [
                "Ink::Subject names the subject, chosen value, built term, destination file or broken artifact; Detail explains it; Aside carries indices, costs, timings and inactive markers, except that the status bar's ready count and total cost read Subject",
                "A focused body row keeps its rank inks and gains HL #26262a plus bold across the whole row",
                "An editor question that owns the keyboard uses bold without the row band through Ink::lit",
                "Underline means clickable and inherits the link's semantic rank",
                "The header is chrome outside the body focus grammar: the title is an inverted block without weight and only the language chip is bold",
                "Sentence label blocks use gray for current attribution and white for explicitly changed or fulfilled pinned values",
                "An armed confirmation is bold under the ordinary rule, because for its confirmation window that key is what the keyboard owns; the outcome loss tag is the one deliberate bold exception",
                "Sentence label chips use dark background letters; one plain space separates axis groups and no vertical rail, rule or filled backing sits behind them",
            ],
            grounds: Grounds(
                rationale: [
                    "Each channel carries one meaning: ink is rank inside the row, background is focus, weight is what the keyboard owns, and underline is clickability, so the same affordance reads at three depths without three link colours",
                    "The loss tag is bold because it is the one sentence a settled screen must not let the eye slide past",
                ],
                sources: [
                    Source(file: "src/tui/palette.rs", symbol: "Ink"),
                    Source(file: "src/tui/screens/sentence_labels.rs", symbol: "tag_style"),
                ],
                tests: [
                    Check(file: "tests/your_cards.rs", test: "a_built_card_lights_its_term_and_leaves_its_sentence_quiet"),
                    Check(file: "tests/what_i_understood.rs", test: "the_selected_review_row_differs_from_its_neighbours_by_cursor_alone"),
                    Check(file: "tests/your_cards.rs", test: "walking_into_an_open_card_lights_its_first_question_alone"),
                    Check(file: "src/tui/pointer.rs", test: "rendered_underlined_file_cells_are_inside_hand_pointer_regions"),
                    Check(file: "tests/done.rs", test: "a_body_without_a_cursor_carries_no_weight_at_all"),
                    Check(file: "tests/your_cards.rs", test: "best_effort_axes_show_the_actual_value_and_requested_target"),
                ],
            ),
        ),
        Rule(head: Head(id: "keyboard.grammar", intent: "A key learned on one screen does the same on every other, and walking past an open block never closes what was opened"),
            scope: Everywhere,
            expectations: [
                "Up/Down walk vertically through lists, open blocks and editor rows; Left/Right first serve a focused horizontal control",
                "On a disclosure head Right opens what Enter opens and Left closes what Escape closes",
                "Enter opens or confirm-closes the focused disclosure; Space marks or acts; Escape closes one focused layer",
                "C toggles the screen's disclosures: if anything is open it collapses all, otherwise it opens eligible sense lists or all cards while editors stay closed",
                "Expanded blocks remain open when focus walks away; walking back enters their interior",
                "j and k mirror Down and Up outside real text input on review and cards; Tab and Shift+Tab map to no event",
                "Ctrl+G names what the user gets: understand, generate, regenerate, or save when every card is ready but its study package is unpublished; the error panel names it retry",
                "R has no review or card action; missing senses are reached through + add more",
                "C works outside real text input including carousel rows; the focused note types a literal c, and the C footer reads secondary expand or collapse according to its direction",
                "Space on a card head is an unadvertised alias of Enter for opening and closing",
            ],
            grounds: Grounds(
                rationale: [
                    "One key means one action on every screen, so the footer can teach a key once and the learner can trust it everywhere",
                    "Expanded blocks are pass-through views, so walking never closes what the learner opened; C is the one sweep that closes everything",
                ],
                sources: [
                    Source(file: "src/tui/transition.rs", symbol: "transit"),
                    Source(file: "src/tui/input.rs", symbol: "to_app"),
                    Source(file: "src/tui/disclosure.rs", symbol: "DisclosureControls"),
                ],
                tests: [
                    Check(file: "tests/your_cards.rs", test: "the_side_arrows_open_and_close_the_focused_card_without_entering_its_editor"),
                    Check(file: "tests/your_cards.rs", test: "enter_opens_the_card_while_the_walk_opens_its_editor_and_escape_peels_layers"),
                    Check(file: "tests/what_i_understood.rs", test: "c_opens_only_multi_sense_lists_when_none_is_open"),
                    Check(file: "tests/what_i_understood.rs", test: "up_from_a_candidate_head_reenters_the_previous_open_list_at_its_add_more_row"),
                    Check(file: "tests/your_cards.rs", test: "the_vim_walk_reaches_the_cards_screen_too"),
                    Check(file: "tests/sentence_labels_editor.rs", test: "both_r_keys_are_inert_while_space_opens_the_card_and_a_tag_opens_the_live_editor"),
                ],
            ),
        ),
        Rule(head: Head(id: "keyboard.layouts", intent: "Printed shortcuts work from Russian, Ukrainian or Greek layouts without switching, while every typed word keeps exactly the letters entered"),
            scope: Everywhere,
            expectations: [
                "Ctrl/Cmd shortcuts fold through latin_key; review and card commands fold ordinary letters only outside real text inputs",
                "ЙЦУКЕН, Ukrainian and Greek layouts can trigger the printed English shortcuts",
                "Words, Welcome key input, modal text and a focused rewrite note retain the exact typed codepoints",
                "Ctrl+N/Ctrl+P scroll shortcuts follow the same physical-key fold",
            ],
            grounds: Grounds(
                rationale: [],
                sources: [
                    Source(file: "src/tui/input.rs", symbol: "latin_key"),
                    Source(file: "src/tui/transition.rs", symbol: "promote"),
                    Source(file: "src/cli/terminal.rs", symbol: "scroll_hotkey_screen"),
                ],
                tests: [
                    Check(file: "tests/keyboard.rs", test: "ctrl_g_normalizes_ascii_russian_and_greek_layouts"),
                    Check(file: "tests/keyboard.rs", test: "ctrl_l_normalizes_ascii_russian_and_greek_layouts"),
                    Check(file: "tests/what_i_understood.rs", test: "review_letter_hotkeys_answer_on_a_russian_layout"),
                    Check(file: "tests/your_cards.rs", test: "the_collapse_toggle_answers_on_a_russian_layout"),
                    Check(file: "tests/your_words.rs", test: "the_words_screen_keeps_every_letter_the_layout_produced"),
                    Check(file: "tests/your_cards.rs", test: "a_russian_note_keeps_the_letters_it_was_typed_with"),
                ],
            ),
        ),
        Rule(head: Head(id: "footer.promises", intent: "Each footer hint can be trusted to act right now, so a key that would only scold or silently queue a restart stays off the bar"),
            scope: Everywhere,
            expectations: [
                "ScreenView provides left status and right hints; render_screen suppresses base hints under modal or busy ownership and retains global quit",
                "Ctrl+G is hidden above the intake or card ceiling, while card work is running, and on a finished result with nothing staged; it reads save when every card is ready but unpublished",
                "The empty words box has no bright action key because typing needs no named key; no hint names Cmd+V",
                "Disclosure hints read open or close with the matching Enter/Right or Enter/Left chord; the open tunable head offers Down tune",
                "Navigation is nav and horizontal choices are pick; key brackets contain no inner spaces",
            ],
            grounds: Grounds(
                rationale: [
                    "A hint is a promise that the key does something now; a bright key that only scolds or silently queues a restart teaches the learner to ignore the bar",
                ],
                sources: [
                    Source(file: "src/tui/screens/mod.rs", symbol: "ScreenView"),
                    Source(file: "src/tui/screens/common.rs", symbol: "render_screen"),
                    Source(file: "src/tui/screens/your_cards.rs", symbol: "hints"),
                ],
                tests: [
                    Check(file: "tests/your_words.rs", test: "busy_loader_takes_the_screen_hints_down_with_the_keyboard"),
                    Check(file: "tests/your_cards.rs", test: "a_published_batch_with_nothing_owed_stops_offering_regeneration"),
                    Check(file: "tests/your_cards.rs", test: "completed_artifacts_cannot_claim_that_an_unpublished_batch_is_all_done"),
                    Check(file: "tests/your_words.rs", test: "an_empty_words_box_spends_no_brightness_on_a_key_the_app_does_not_own"),
                    Check(file: "tests/what_i_understood.rs", test: "a_head_over_an_open_list_points_at_the_arrow_that_works"),
                    Check(file: "tests/your_cards.rs", test: "an_open_tunable_card_advertises_the_walk_into_its_editor"),
                ],
                gaps: [
                    Gap(
                        summary: "Under a plain error overlay the base hints stay visible ([Esc] clear and [Ctrl+L] languages on words, [Esc] stop on cards) although those keys only dismiss the error; screen_hints suppresses base hints only for busy and modal overlays",
                        sources: [
                            Source(file: "src/tui/screens/common.rs", symbol: "screen_hints"),
                        ],
                    ),
                    Gap(
                        summary: "An excluded review head still advertises [Enter/→] open although opening it is a no-op",
                        sources: [
                            Source(file: "src/tui/screens/what_i_understood.rs", symbol: "hints"),
                            Source(file: "src/tui/app.rs", symbol: "sense_list_toggled"),
                        ],
                    ),
                    Gap(
                        summary: "[Esc] new cards can be advertised while Esc is inert: when a card is staged during generation and the queue drains, App::can_start_new_batch holds but the shell gate still sees the live engine",
                        sources: [
                            Source(file: "src/tui/app.rs", symbol: "can_start_new_batch"),
                            Source(file: "src/cli/shell.rs", symbol: "can_start_new_batch"),
                        ],
                    ),
                    Gap(
                        summary: "An unfinished batch with no running engine, such as a reopened failed or cancelled session, advertises [Esc] stop although the shell refuses to arm a stop without an engine",
                        sources: [
                            Source(file: "src/tui/screens/your_cards.rs", symbol: "stop_generation_hint"),
                            Source(file: "src/cli/shell.rs", symbol: "can_confirm"),
                        ],
                    ),
                    Gap(
                        summary: "Welcome uses [↑↓←→] language and [←→] move and the pair picker uses [←→] column instead of the nav and pick vocabulary",
                        sources: [
                            Source(file: "src/tui/screens/welcome.rs", symbol: "hints"),
                            Source(file: "src/tui/screens/modals.rs", symbol: "draw_picker"),
                        ],
                    ),
                ],
            ),
        ),
        Rule(head: Head(id: "footer.rank-order", intent: "However narrow the terminal, the main action and the way out stay on the bar; hints drop whole rather than clip, and quit yields only to the main action or an armed key"),
            scope: Everywhere,
            expectations: [
                "Primary uses Subject, Secondary uses Detail and Ghost uses Aside; ordinary hints are neither bold nor underlined",
                "Armed confirmations alone use a bright bold hint",
                "The walk's Ctrl+G and the doors into the focused row are painted primary, but doors keep only Useful rank and are shed before quit; closing a disclosure and C are secondary; inside an open sense list [Space] select or [Space] add is the main action and Ctrl+G drops to secondary",
                "Order hints as main action, focused doors, screen actions, conventional navigation/languages, Escape, then quit",
                "Drop whole hints without clipping from Optional through Useful, Exit, Main and Confirm, rightmost first on ties",
                "Quit has its own Exit priority and outlives screen actions; the main action and an armed confirmation outlive quit",
                "Escape back is a ghost and the first conventional hint dropped; destructive Escape actions survive ordinary conventional keys",
            ],
            grounds: Grounds(
                rationale: [
                    "Brightness and survival are separate axes: a quiet key can outlive a loud one, so the exit outlives every screen action and yields only to the spine and to a confirmation already armed",
                    "[Esc] back is the one Escape that breaks nothing, so it is drawn as a ghost and is the first hint a narrowing bar sheds",
                ],
                sources: [
                    Source(file: "src/tui/screens/common.rs", symbol: "FooterHint"),
                    Source(file: "src/tui/screens/common.rs", symbol: "Keep"),
                    Source(file: "src/tui/screens/common.rs", symbol: "Tier"),
                ],
                tests: [
                    Check(file: "src/tui/screens/common.rs", test: "the_three_footer_tiers_separate_by_ink_and_never_by_weight"),
                    Check(file: "src/tui/screens/common.rs", test: "an_armed_confirmation_is_the_one_hint_the_bar_draws_with_weight"),
                    Check(file: "src/tui/screens/common.rs", test: "a_door_is_still_shed_before_the_way_out"),
                    Check(file: "tests/what_i_understood.rs", test: "the_review_bar_reads_from_what_it_builds_down_to_the_way_out"),
                    Check(file: "src/tui/screens/common.rs", test: "the_exit_outlives_the_screen_actions_that_used_to_tie_with_it"),
                    Check(file: "src/tui/screens/common.rs", test: "the_way_back_is_the_first_hint_a_narrowing_bar_sheds"),
                ],
                gaps: [
                    Gap(
                        summary: "Welcome's [Esc] back is a secondary Useful hint rather than the review's ghost back",
                        sources: [
                            Source(file: "src/tui/screens/welcome.rs", symbol: "hints"),
                        ],
                    ),
                    Gap(
                        summary: "The open generation-guidance editor omits [Ctrl+C] quit entirely, so an armed [Ctrl+C] again is invisible there",
                        sources: [
                            Source(file: "src/tui/screens/what_i_understood.rs", symbol: "hints"),
                        ],
                    ),
                ],
            ),
        ),
