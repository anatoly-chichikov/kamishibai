            Scenario(head: Head(id: "cards.parked-reading", intent: "Cards opened along the way stay open as the walk moves on, and a single sweep closes them all once the reading is done"),
                route: ["cards.closed", "cards.parked", "cards.tuning", "cards.parked", "cards.closed"],
                expectations: [
                    "Walking out parks the editor and C closes all open cards",
