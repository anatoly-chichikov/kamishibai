                            source: SourceRef(file: "src/tui/screens/your_cards.rs", line: 405),
                            purpose: "attribute the incremental spend to the row that earned it: the folder row folds meta and scene (the card's total minus voice and scene-row spend), voice and scene carry only their own artifact including retries, and the head keeps the card total",
                            importance: 4,
                            usefulness: 5,
                            health: Working,
                            issues: [],
                        ),
                        Element(
                            id: ElementId("yc.sentence_label_tags"),
                            kind: DetailBlock,
                            text: Template([
                                Bind(DataPath("visible while no editor is open, anchored on the voice row")),
                                Bind(DataPath("staged rewrite selection or CardMeta::sentence_labels() actual register")),
                                Static(" "),
                                Bind(DataPath("actual sentence type")),
                                Static(" "),
                                Bind(DataPath("actual lowercase operational CEFR band for the language surrounding the target term")),
                                Bind(DataPath("best-effort mismatch as gray actual tag, muted · aimed for, and white requested tag")),
                            ]),
                            source: SourceRef(file: "src/tui/screens/sentence_labels.rs", line: 191),
                            purpose: "place separate register, type, and lowercase CEFR axis groups as one atomic sequence: a no-target batch level writes the natural sentence first and only then classifies its surrounding language without targeting a band or counting the target term itself, while an explicit batch level constrains initial generation and a later per-card level change constrains rewriting; unchanged actual tags have a gray DIM background, exact changed or pinned tags have a white background without bold, and a best-effort mismatch keeps the gray actual plus muted aimed-for copy and the white requested target in one atomic group; the sequence anchors on the voice row at the fixed post-state column, whole groups may wrap onto the scene row at that same column, and the summary hides atomically when the complete set cannot fit — the card head then stays the mouse entry into tuning",
                            importance: 5,
                            usefulness: 5,
                            health: Working,
                            issues: [],
                        ),
                        Element(
                            id: ElementId("yc.sentence_label_axes"),
                            kind: DetailBlock,
                            text: Template([
                                Static("how should it sound? < "),
                                Bind(DataPath("SentenceLabelsEditor register selection and choices")),
                                Static(" >\nwhat kind of phrase? < "),
                                Bind(DataPath("SentenceLabelsEditor sentence-type selection and choices")),
                                Static(" >\nwhat's the desired level? < "),
                                Bind(DataPath("SentenceLabelsEditor lowercase CEFR selection and choices")),
                                Static(" >"),
                                Bind(DataPath("when a selected target differs from generated attribution: muted current plus the actual token")),
                            ]),
                            source: SourceRef(file: "src/tui/screens/sentence_labels.rs", line: 456),
                            purpose: "replace the inline summary after exactly one blank row below the three step rows: every carousel is permanently bracketed by a two-cell '< ' and ' >' direction control, both cells are clickable, and either control focuses its own row and moves one adjacent choice while saturating at the boundary; all three tracks share one render-time width derived from the widest choice and the largest choice count across the axes, and their chevrons align; inside that track the selected chip's visual centre advances proportionally with its choice index, while every adjacent step transfers one hidden-choice segment from the trailing rail to the leading rail; segments differ by at most one cell, spare cells sit nearest the chip on each side, and every segment cell is clickable; distance colours run DIM2, RULE, then HL; when the selected target differs from the generated attribution, muted current plus the actual token stays on the same line or continues beneath that axis without changing its hit geometry; a legacy empty axis shows a centred dash with one clickable two-cell marker on each side inside the shared track; no grammar axis exists",
                            importance: 5,
                            usefulness: 5,
                            health: Working,
                            issues: [],
                        ),
                        Element(
                            id: ElementId("yc.sentence_label_note"),
