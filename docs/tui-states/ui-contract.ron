                        ),
                        Element(
                            id: ElementId("yc.pending_card"),
                            kind: DetailBlock,
                            text: Template([
                                Bind(DataPath("CardDraft::staged_rewrite()")),
                                Static(" => target sentence struck; current metadata and the step rows muted; staged choices remain visible in the voice-row tag summary or the editor below the rows"),
                            ]),
                            source: SourceRef(file: "src/tui/screens/your_cards.rs", line: 209),
                            purpose: "make every unapplied sentence edit visible while preserving the current card until Ctrl+G; regeneration aims for every requested preset value, while a best-effort mismatch keeps the generated actual attribution and requested target separate",
                            importance: 5,
                            usefulness: 5,
                            health: Working,
                            issues: [],
                        ),
                        Element(
                            id: ElementId("yc.step_rows"),
