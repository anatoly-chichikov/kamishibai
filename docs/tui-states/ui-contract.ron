                ]),
                source: SourceRef(file: "src/tui/screens/common.rs", line: 84),
                purpose: "anchors the user in the current wizard step",
                importance: 5,
                usefulness: 5,
                health: Working,
                issues: [],
            ),
            Element(
                id: ElementId("header_tagline"),
                kind: HeaderTagline,
                text: Template([
                    Bind(DataPath("Screen::tagline (flavor copy on 3 screens, real progress on YourCards)")),
