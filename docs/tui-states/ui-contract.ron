// kamishibai · TUI UI element contract
//
// Serialized instance of `tests/ui_contract.rs::schema::Contract`.
// The schema is the source of truth for what fields/variants exist; this
// file is the data. Run `cargo test --test ui_contract` to validate it.
//
// Hierarchy:
//   Contract → App → { Chrome, Screen[], Modal[] }
//   Screen   → Region[]      (one of Chrome/Header/Body/Status/Footer/Banner/Modal)
//   Region   → Element[]
//   Element  → { id, kind, text, source, purpose, importance, usefulness, health, issues[] }
//   Issue    → enum: BrokenWiring | HiddenBinding | FakeData | DuplicateOf
//                  | DriftFromDesign | SpecPromiseUnfulfilled
//                  | CopyInconsistency | MisleadingLabel
//
// Read top-down for inventory; jump by Issue variant to read structurally.

Contract(
    meta: Meta(
        framework: "ratatui + crossterm",
        terminal_size_assumed: TerminalSize(cols: 80, rows: 12),
        sources_checked: [
            "src/cli.rs",
            "src/session/engine.rs",
            "src/tui/event.rs",
            "src/tui/transition.rs",
            "src/tui/input.rs",
