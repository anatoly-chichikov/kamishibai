                            text: Template([
                                Bind(DataPath("step_rows_for(): folder (meta) · voice (audio) · scene (visual phase), each a visible line only once started")),
                                Bind(DataPath("state glyph: ✓ ready | spinner + ai is working… active | ✗ gave up | ⊘ discarded | · spent-but-idle | ○ queued")),
                                Bind(DataPath("row cost in dim2: folder = meta + scene spend, voice = sound spend, scene = picture spend, retries included")),
                            ]),
                            source: SourceRef(file: "src/tui/screens/your_cards.rs", line: 715),
                            purpose: "render the same three step rows in every card state — collapsed, expanded, editor open — starting immediately after the head's last target-sentence line, with no file names, sizes, or cached note anywhere; each label is an underlined link when its target exists (folder opens the card's cache cell, voice opens the audio file, scene opens the rendered page) and plain text otherwise; the scene row folds the scene and picture slots into one line whose spinner covers both, a ready scene with its picture still owed keeps a dim dot, and a staged rewrite mutes the rows while the batch keeps them visible",
                            importance: 5,
