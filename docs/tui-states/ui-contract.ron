                source: SourceRef(file: "src/tui/screens/common.rs", line: 84),
                purpose: "anchors the user in the current wizard step",
                importance: 5,
                usefulness: 5,
                health: Working,
                issues: [],
            ),
            Element(
                id: ElementId("header_tagline"),
