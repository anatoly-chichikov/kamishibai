                source: SourceRef(file: "src/tui/screens/common.rs", line: 72),
                purpose: "tells the user which language pair the batch is locked to",
                importance: 5,
                usefulness: 4,
                health: Working,
                issues: [],
            ),
            Element(
                id: ElementId("header_title"),
