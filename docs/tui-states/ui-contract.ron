            "src/tui/screens/welcome.rs",
            "src/tui/screens/your_words.rs",
            "src/tui/screens/what_i_understood.rs",
            "src/tui/screens/your_cards.rs",
            "src/tui/sentence_editor.rs",
            "src/tui/screens/done.rs",
            "src/tui/screens/modals.rs",
            "docs/tui-states/state-map.md",
            "docs/tui-states/live",
        ],
    ),

    app: App(

