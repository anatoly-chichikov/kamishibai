{
  "audio_prompt_template": "Say in natural English: {text}",
  "image_model": "gemini-3.1-flash-image-preview",
  "scene_model": "gemini-3-flash-preview",
  "scene_prompt_header": [
    "You are a manga scene composer for educational English flashcards. Translate the English sentence into a JSON array of manga panels.",
    "",
    "INPUT SENTENCE:",
    "{sentence}"
  ],
  "template": {
    "manga_panel": {
      "art_style": {
        "composition": {
          "cinematic_framing": true,
          "dynamic_perspective": true,
          "emotional_closeups": true,
          "motion_rendering": "speed_lines_and_blur",
          "scale_juxtaposition": true
        },
        "contrast": {
          "distribution": "calculated",
          "focal_emphasis": true,
          "range": "extreme",
          "value_separation": true
        },
        "detail": {
          "anatomical_precision": "high",
          "background_detail_level": "full",
          "density": "extreme",
          "environmental_precision": "high",
          "texture_differentiation": true
        },
        "line_work": {
          "contour_emphasis": true,
          "organic_stroke": "fine_pointed",
          "outline_weight": "variable",
          "stroke_confidence": "high",
          "structural_stroke": "chiseled",
          "weight_range": "wide"
        },
        "medium": {
          "base": "indian_ink",
          "color_mode": "monochrome_with_screentone",
          "surface": "high_density_smooth"
        },
        "screen_tone": {
          "dot_pattern": "fine",
          "enabled": true,
          "usage": [
            "skin",
            "fabric",
            "atmosphere",
            "gradients",
            "metallic_surfaces"
          ]
        },
        "shading": {
          "black_fill_zones": true,
          "gradient_method": "hatching_density_variation",
          "hatching_density": "high",
          "hatching_directionality": "form_following",
          "primary_method": "crosshatching",
          "secondary_method": "screen_tone",
          "white_on_black_highlights": true
        }
      },
      "canvas": {
        "format": "square",
        "height": 1024,
        "width": 1024
      },
      "constraints": {
        "genre_lock": false,
        "layout_lock": false,
        "panel_count_lock": false,
        "style_lock": true,
        "text_rendering": "forbidden"
      },
      "meta": {
        "description": "",
        "spec_version": "1.0.0",
        "tags": [],
        "title": ""
      },
      "panel_layout": {
        "allow_bleed": false,
        "allow_overlap": false,
        "border_style": "solid_black",
        "border_weight": 2,
        "gutter_width": 8,
        "outer_margin": 16
      },
      "panels": [],
      "rendering_rules": {
        "outer_border": "16px_pure_white",
        "panel_gutters": "clean_white_no_text",
        "signs_and_labels": "blank_or_hidden",
        "sound_effects": "none",
        "speech_bubbles": "none",
        "symbols_or_writing": "none",
        "text_elements": "none"
      }
    }
  },
  "tts_models": [
    "gemini-2.5-flash-preview-tts",
    "gemini-2.5-pro-preview-tts"
  ],
  "voice_pool": [
    "Achernar",
    "Achird",
    "Algenib",
    "Algieba",
    "Alnilam",
    "Aoede",
    "Autonoe",
    "Callirrhoe",
    "Charon",
    "Despina",
    "Enceladus",
    "Erinome",
    "Fenrir",
    "Gacrux",
    "Iapetus",
    "Kore",
    "Laomedeia",
    "Leda",
    "Orus",
    "Puck",
    "Pulcherrima",
    "Rasalgethi",
    "Sadachbia",
    "Sadaltager",
    "Schedar",
    "Sulafat",
    "Umbriel",
    "Vindemiatrix",
    "Zephyr",
    "Zubenelgenubi"
  ]
}
